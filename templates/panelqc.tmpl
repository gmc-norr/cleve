{{ define "panelqc" }}
{{ template "header" . }}

<header class="m-6">
    <h2 class="text-3xl">GenePanel QC for {{ .panelqc.RunId }}
    </h2>
</header>

{{ range .panelqc.GenePanel }}
    <section class="mx-6 mb-6 overflow-x-auto">
    
        <table class="bg-accent-100 my-6 max-w-fit">
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Gene Panel ID</th>
                <td class="px-2">{{ .GenePanelId }}</td>
            </tr>
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Completness Threshold</th>
                <td class="px-2">{{ .CompletnessThreshold  }}</td>
            </tr>
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Feature Fraction</th>
                <td class="px-2">{{ .FeatureFraction }}</td>
            </tr>
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Number of Samples</th>
                <td class="px-2"><code>{{ .NumberSamples }}</code></td>
            </tr>
        </table>

    
        <table class="w-full ">
            <thead class="text-left">
                <tr class="border-b border-slate-500">
                    <th>HGNC</th>
                    <th>Symbol</th>
                    <th>Gene type</th>
                    <th>Mean Coverage</th> 
                    <th>Mean Completness</th>
                    <th>Pseudogenes</th>
                    <th>Segment Duplication</th>
                </tr>
                
            </thead>

            <tbody class="border-y border-slate-500" id="genes-body">
                {{ range .Genes }}
                <tr class="hover:bg-accent-100">
                    
                    <td>{{ .HGNC }}</td>
                    <td>{{ .Symbol }}</td>
                    <td>{{ .Gene_type  }}</td>
                    <td>{{ .Mean_coverage }}</td>
                    <td>{{ .Mean_completness }}</td>
                    <td>{{ .Pseudogene }}</td>
                    <td>{{ .Segment_duplication }}</td>
                    
                </tr>
                {{ end }}
            </tbody>
        
        </table>


        {{ $incomplete_exons_found := false}}
        {{ range .Genes }}
            {{ if .Incomplete_exons}}
            {{ $incomplete_exons_found = true}}
            <h3 class="text-2xl my-4"> Incomplete Exons for: {{ .HGNC}} </h3>

            <table class="w-full ">
                <thead class="text-left">
                    <tr class="border-b border-slate-500">
                        <th>Exon number type</th>
                        <th>Completness</th> 
                        <th>Transcript</th>
                        <th>Mane Select </th>
                    </tr>
                    
                </thead>

                <tbody class="border-y border-slate-500" id="panelqc-body">
                    <tr class="hover:bg-accent-100">
                    {{ range .Incomplete_exons }}
                        <td>{{ .Exon_number   }}</td>
                        <td>{{ .Completness  }}</td>
                        <td>{{ .Transcript  }}</td>
                        <td>{{ .Mane_select  }}</td>
                    {{ end }}
                    </tr>
                </tbody>

            
            </table>
            {{ end }}

        {{ end }}

        {{ if not $incomplete_exons_found}}
        <h3 class="text-2xl my-4"> No Incomplete Exons found </h3>
        {{ end }}

                

    
    </section>
{{ end }}




{{ template "footer" }}
{{ end }}