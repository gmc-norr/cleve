{{ define "panelqc" }}
{{ template "header" . }}

<header class="m-6">
    <h2 
        class="text-3xl">GenePanel QC for {{ .panelqc.RunId }}
    </h2>
</header>


{{ range .panelqc.GenePanel }}
    <section class="m-6">
    
        <table class="bg-accent-100 my-6 max-w-fit">
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Gene Panel ID</th>
                <td class="px-2">{{ .GenePanelId }}</td>
            </tr>
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Completness Threshold</th>
                <td class="px-2">{{ .CompletnessThreshold  }}</td>
            </tr>
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Feature Fraction</th>
                <td class="px-2">{{ .FeatureFraction }}</td>
            </tr>
            <tr>
                <th class="bg-accent-900 text-accent-100 text-right px-2">Number of Samples</th>
                <td class="px-2"><code>{{ .NumberSamples }}</code></td>
            </tr>
        </table>

    
        <table class="w-full">
            <thead class="text-left">
                <tr class="border-b border-slate-500">
                    <th>HGNC</th>
                    <th>Symbol</th>
                    <th>Mapping Quality</th> 
                    <th>Suboptional Coverage</th> 
                    <th>Mean Coverage</th> 
                    <th>Mean Completness %</th>
                </tr>
                
            </thead>

            <tbody class="border-y border-slate-500" id="genes-body">
                {{ range .Genes }}
                <tr class="hover:bg-accent-100 
                    {{if eq .Suboptional_coverage true}} tablehighlightbad
                    {{end}}">
                    
                    <td>{{ .HGNC }}</td>
                    <td>{{ .Symbol }}</td>
                    <td>{{ .Mean_mapping_quality  }}</td>
                    <td>{{ .Suboptional_coverage  }}</td>
                    <td>{{ .Mean_coverage }}</td>
                    <td>{{ .Mean_completness }}</td>
                    
                </tr>
                {{ end }}
            </tbody>
        
        </table>

        <h2 class="text-2xl my-4"> Coverage/Completness/MQ Chart for each gene </h2>
        <div class="flex flex-col xl:flex-row gap-6 min-w-[900px]">
            <div class="relative isolate w-[900px] h-[500px] m-auto xl:m-0">
                <div id="panelqc-chart-spinner{{ .GenePanelId }}" class="bg-slate-400/25 absolute pointer-events-none w-full h-full htmx-indicator flex items-center justify-center z-10">
                    <span class="flex items-center gap-2 text-4xl"><img class="inline-block size-[.8lh] animate-spin" src="/static/img/spinner.svg"> Loading chart...</span>
                </div>
                <div id="panelqc-chart-container{{ .GenePanelId }}"
                    hx-get="/panelqc/charts/genes/{{ .GenePanelId }}"
                    hx-include="#chart-form"
                    hx-trigger="load"
                    hx-indicator="#panelqc-chart-spinner{{ .GenePanelId }}"
                    hx-swap="innerHTML ignoreTitle:true">
                </div>
            </div>
            <form
                class="flex xl:flex-col justify-center xl:justify-center gap-2"
                id="chart-form"
                autocomplete="off"
                hx-get="/panelqc/charts/genes/{{ .GenePanelId }}"
                hx-target="#panelqc-chart-container{{ .GenePanelId }}"
                hx-trigger="change"
                hx-indicator="#panelqc-chart-spinner{{ .GenePanelId }}"
                hx-swap="innerHtml ignoreTitle:true">
                <label class="flex flex-col">
                    <span class="text-sm font-bold">Genes:</span>
                    <select id="gene-select{{ .GenePanelId }}" class="border rounded-md" name="gene{{.GenePanelId}}">
                        {{ range .Genes }}
                            <option value="{{.Symbol}}">{{.Symbol}}</option>
                        {{ end }}
                    </select>
                </label>
                <label class="flex flex-col">
                    <span class="text-sm font-bold">Data</span>
                    <select id="qcdata-select{{ .GenePanelId }}" class="border rounded-md" name="gene_qcdata{{.GenePanelId}}">
                        <option value="mean_coverage">Mean Coverage</option>
                        <option value="mean_completness">Mean Completness %</option>
                        <option value="mean_mapping_quality">Mean Mapping Quality</option>
                    </select>
                </label>

            </form>

        </div>

        


    </section>
{{ end }}

<script src="/static/js/echarts.min.js"></script>
{{ template "footer" }}
{{ end }}