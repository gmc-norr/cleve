{{ define "error" }}
{{ template "header" . }}
<section class="mx-6">
    <h1 class="text-4xl mb-4">{{ .code }} {{ .status }}</h1>
    {{ if .message }}
    <p class="message my-4">
        {{ .message }}
    </p>
    {{ end }}
    {{ if .error }}
    <p class="error my-4">
        Error: {{ .error }}
    </p>
    {{ end }}
</section>
{{ template "footer" }}
{{ end }}
